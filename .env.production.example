# Fridgestare production environment. Copy to `.env` on the server and fill in.
# Everything here is read by docker-compose.prod.yml; nothing is baked into an image.

# ---------------------------------------------------------------------------
# Public identity
# ---------------------------------------------------------------------------
# Hostname Caddy serves and requests a certificate for. Must resolve to this VM.
SITE_ADDRESS=fridgestare.example.com
# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=you@example.com

# Turns on the startup checks in app/core/config.py. Leave this as production.
APP_ENV=production

# Public URL of the app. Plan emails link to <APP_BASE_URL>/plans/<week>.
# Same origin as the API, so no CORS entries are needed below.
APP_BASE_URL=https://fridgestare.example.com
BACKEND_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
# Changing it logs everyone out; leaving it at the example value is refused at startup.
APP_SECRET_KEY=

# Generate each with: openssl rand -base64 24
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# Must match MARIADB_USER/MARIADB_PASSWORD/MARIADB_DATABASE. `db` is the compose
# service name; the database is not published to the host.
DATABASE_URL=mysql+pymysql://fridgestare:REPLACE_WITH_MARIADB_PASSWORD@db:3306/fridgestare?charset=utf8mb4

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# Required over HTTPS; startup refuses https with this off.
COOKIE_SECURE=true
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------------------------------------------------------------------------
# Email (Mailgun)
# ---------------------------------------------------------------------------
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.fridgestare.example.com
# Use https://api.eu.mailgun.net for an EU sending domain.
MAILGUN_BASE_URL=https://api.mailgun.net
MAIL_FROM_ADDRESS=plans@mg.fridgestare.example.com

# Weekly generation and send. Requires Mailgun above; startup refuses the combination
# of a scheduler with no way to deliver.
SCHEDULER_ENABLED=true

# ---------------------------------------------------------------------------
# Optional integrations. Both degrade to local behavior when blank.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Diagnostics
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# Interactive API docs at /docs. Off in production unless set to true.
DOCS_ENABLED=false
