# Backend database. Compose reaches MariaDB at the `db` service hostname; override
# in .env.local with `localhost` when running the backend on the host.
DATABASE_URL=mysql+pymysql://fridgestare:fridgestare@db:3306/fridgestare?charset=utf8mb4

# Leave `development` locally. `production` turns on startup checks that refuse to
# boot with a placeholder secret, an http base URL, or insecure cookies.
APP_ENV=development
APP_SECRET_KEY=change-me-with-at-least-32-characters

# Public URL of the frontend. Weekly plan emails link to <APP_BASE_URL>/plans/<week>,
# so this must point at the SPA, not the API.
APP_BASE_URL=http://localhost:5173

ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Set to true when serving over HTTPS so session cookies carry the Secure flag.
COOKIE_SECURE=false

# Optional integrations. Each falls back to local behavior when left blank:
# OpenRouter improves chat parsing, Tavily enables live recipe discovery, and
# Mailgun sends real email instead of a mock delivery.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
TAVILY_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Use https://api.eu.mailgun.net for an EU Mailgun sending domain.
MAILGUN_BASE_URL=https://api.mailgun.net
MAIL_FROM_ADDRESS=hello@fridgestare.local

# Background generation and weekly email delivery. Off by default.
SCHEDULER_ENABLED=false

BACKEND_CORS_ORIGINS=http://localhost:5173

# Frontend dev-server proxy target. Compose overrides this to http://backend:8000.
VITE_API_PROXY_TARGET=http://localhost:8000

LOG_LEVEL=INFO
# Interactive API docs at /docs. Unset follows APP_ENV: on locally, off in production.
DOCS_ENABLED=
